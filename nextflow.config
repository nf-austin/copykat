manifest {
    name            = 'nf-austin/copykat'
    author          = 'Austin Varela'
    homePage        = 'https://github.com/nf-austin/copykat'
    description     = 'Automated CopyKAT pipeline with clustering, ploidy prediction, CIN scoring, and matrix concatenation'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
    defaultBranch   = 'main'
}

params {
    // Input / output -- provide EITHER --input or --h5ad_dir.
    // Samplesheet CSV with columns: sample, h5ad. This is the mode Seqera
    // Platform launches with (nextflow_schema.json gives it a file picker).
    input      = null
    // Ad-hoc alternative: a glob over .h5ad files, sample id taken from the
    // filename with any trailing "_annotated" stripped.
    h5ad_dir   = null
    outdir     = "results"
    help       = false

    // CopyKAT settings
    id_type    = "S"      // "S" for gene symbols, "E" for Ensembl IDs
    cell_line  = "no"     // "yes" for cell lines, "no" for primary tissue
    ngene_chr  = 5        // minimum genes per chromosome
    low_dr     = 0.05     // lower bound of dynamic range
    up_dr      = 0.1      // upper bound of dynamic range
    win_size   = 25       // minimum window size for segmentation
    distance   = "euclidean"
    ks_cut     = 0.1      // KS statistics cutoff for ploidy prediction
    genome     = "hg20"   // genome assembly: hg20 (hg38), hg19, mm10

    // Container images, published to GHCR by .github/workflows/docker.yml.
    // Pinned rather than :latest so runs stay reproducible; bump alongside
    // manifest.version. Two images because the R/Bioconductor stack that
    // CopyKAT needs and the scanpy stack the annotation steps need do not share
    // a base.
    copykat_container    = "ghcr.io/nf-austin/copykat:1.0.0"
    copykat_py_container = "ghcr.io/nf-austin/copykat:1.0.0-py"

    // Resource caps (applied via process.resourceLimits below). Use Nextflow
    // unit literals (.GB, .h) so values stay typed as MemoryUnit / Duration.
    max_memory = 128.GB
    max_cpus   = 32
    max_time   = 72.h

    // Execution environment. Used by the `slurm` profile; ignored otherwise.
    // Seqera Platform's own SLURM compute environment sets the executor itself,
    // so the profile is mainly for launching by hand from a login node.
    slurm_queue     = null   // sbatch --partition
    slurm_account   = null   // sbatch --account
    cluster_options = null   // raw sbatch options, e.g. '--qos=long'

    // Caches. Left null so NXF_SINGULARITY_CACHEDIR / NXF_CONDA_CACHEDIR or an
    // explicit flag wins, and Nextflow's own $NXF_HOME default applies otherwise.
    // Point these at shared storage on a cluster: $HOME is quota-limited and not
    // always mounted on compute nodes. Never at ${projectDir} -- on a Platform
    // launch that is a fresh scratch clone per run, so nothing would ever cache.
    singularity_cache_dir = null
    conda_cache_dir       = null

    // Extra Singularity bind mounts. autoMounts only binds paths Nextflow has
    // resolved, and HPC filesystems are routinely symlinked (/data -> /mnt/gpfs/..),
    // which surfaces as "file not found" inside the container despite the host
    // path existing. Comma-separated, e.g. '/mnt/gpfs,/scratch'.
    singularity_bind = null
}

process {
    // Nextflow 24.04+ enforces these caps automatically on every task.
    resourceLimits = [
        memory: params.max_memory,
        cpus  : params.max_cpus,
        time  : params.max_time
    ]

    withName: 'ANNOTATE_H5AD|CONCAT_H5ADS' {
        cpus          = { workflow.stubRun ? 1     : 4 * task.attempt }
        memory        = { workflow.stubRun ? 1.GB  : 16.GB * task.attempt }
        time          = { workflow.stubRun ? 10.m  : 2.h * task.attempt }
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    withName: 'RUN_COPYKAT' {
        // -stub-run touches no data, so it must not demand a big node --
        // otherwise validating the wiring fails on any laptop with "Process
        // requirement exceeds available CPUs".
        cpus          = { workflow.stubRun ? 1     : 16 * task.attempt }
        memory        = { workflow.stubRun ? 1.GB  : 64.GB * task.attempt }
        time          = { workflow.stubRun ? 10.m  : 24.h * task.attempt }
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}

// Execution reports. Seqera Platform renders these, and they are the first
// thing to look at when a run misbehaves. overwrite so -resume does not fail on
// a pre-existing file.
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

profiles {
    // Executor only -- deliberately touches no container-engine setting, so its
    // key set stays disjoint from the engine profiles below and
    // `-profile slurm,singularity` composes in either order.
    // A null queue/clusterOptions emits no sbatch flag at all (verified on 26.04),
    // so these are safe to assign unconditionally -- which matters, because
    // `nextflow lint` rejects an `if` statement inside a config block.
    slurm {
        process.executor       = 'slurm'
        process.queue          = params.slurm_queue
        process.clusterOptions = params.cluster_options
    }
    docker {
        docker.enabled      = true
        // userEmulation was removed in Nextflow 24.x; fixOwnership replaces it.
        docker.fixOwnership = true
        singularity.enabled = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = params.singularity_cache_dir
        singularity.runOptions = params.singularity_bind ? "-B ${params.singularity_bind}" : null
        docker.enabled         = false
        conda.enabled          = false
    }
    conda {
        // Partial support only: ANNOTATE_H5AD and CONCAT_H5ADS resolve through
        // their environment.yml, but RUN_COPYKAT cannot -- CopyKAT installs from
        // GitHub and is not on conda-forge or Bioconda, so that process needs a
        // container. Use docker or singularity for a full run.
        conda.enabled       = true
        conda.cacheDir      = params.conda_cache_dir
        docker.enabled      = false
        singularity.enabled = false
    }
}
