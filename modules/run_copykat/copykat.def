Bootstrap: docker
From: rocker/r-ver:4.4.0

%environment
    # Tell basilisk to use the Python env baked into the container image
    # rather than trying to create one in a read-only filesystem at runtime.
    export BASILISK_USE_SYSTEM_DIR=1

%post
    apt-get update && apt-get install -y --no-install-recommends \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libhdf5-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libpng-dev \
        python3 \
        python3-pip \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

    Rscript -e 'install.packages(
        c("BiocManager", "remotes", "optparse", "Matrix"),
        repos="https://cran.r-project.org")'

    Rscript -e 'BiocManager::install(
        c("zellkonverter", "SummarizedExperiment"), ask=FALSE)'

    Rscript -e 'remotes::install_github("navinlabcode/copykat")'

    # Pre-build the basilisk/Python environment for zellkonverter so it is
    # baked into the image and does not need network access at runtime.
    BASILISK_USE_SYSTEM_DIR=1 Rscript -e '
        library(basilisk)
        library(zellkonverter)
        proc <- basilisk::basiliskStart(zellkonverterAnnDataEnv())
        basilisk::basiliskStop(proc)
        cat("basilisk environment ready\n")
    '

    # Verify all packages load cleanly; fails the build if anything is missing.
    Rscript -e '
        library(optparse)
        library(Matrix)
        library(SummarizedExperiment)
        library(zellkonverter)
        library(copykat)
        cat("All packages OK\n")
    '

%labels
    Author Austin Varela
    Version 1.0.0
