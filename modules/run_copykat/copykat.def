Bootstrap: docker
From: bioconductor/bioconductor_docker:RELEASE_3_23-R-4.6.0

%post
    pip3 install --no-cache-dir --break-system-packages anndata

    Rscript -e 'install.packages(c("optparse", "remotes"), repos="https://cran.r-project.org")'

    Rscript -e 'remotes::install_github("navinlabcode/copykat")'

    # Smoke-test every library that run_copykat.R uses.
    Rscript -e '
        library(reticulate)
        library(optparse)
        library(Matrix)
        library(copykat)
        anndata <- import("anndata")
        cat("anndata version:", anndata$`__version__`, "\n")
        cat("All packages OK\n")
    '

%labels
    Author Austin Varela
    Version 1.0.0